# Maven build output
target/

# Maven wrapper: the scripts and .properties ARE committed on purpose (that is the
# whole point of a wrapper), but the downloaded distribution is not.
.mvn/wrapper/maven-wrapper.jar

# IDEs
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Logs and local data
*.log
logs/
/data/

# JMH raw output. The numbers worth keeping are transcribed into the README with the machine
# they came from; a results file with no hardware attached to it is not evidence of anything.
headway-bench/results.json

# Secrets — never commit these
.env
*.local.properties
