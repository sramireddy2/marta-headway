<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.headway</groupId>
  <artifactId>headway-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Headway</name>
  <description>Real-time transit bunching detector for MARTA</description>

  <modules>
    <module>headway-common</module>
    <module>headway-gtfs</module>
    <module>headway-ingest</module>
    <module>headway-stream</module>
    <module>headway-api</module>
    <module>headway-bench</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Dependency versions live here so every module agrees on one number. -->
    <!--
      `mvn -pl headway-ingest -am exec:java` also visits the parent and headway-common,
      which have no main class. Default exec to "skip" here; the runnable module opts in.
    -->
    <exec.skip>true</exec.skip>
    <exec.mainClass>none</exec.mainClass>
    <!--
      Same problem, same shape, different plugin. `mvn -pl headway-api -am spring-boot:run` also
      visits the parent and headway-common, neither of which has a Spring application in it, and
      the run goal fails there with "Unable to find a suitable main class". Default it to skip;
      headway-api sets it back to false.
    -->
    <spring-boot.run.skip>true</spring-boot.run.skip>

    <gtfs.rt.bindings.version>0.2.0</gtfs.rt.bindings.version>
    <guava.version>33.6.0-jre</guava.version>
    <commons.csv.version>1.14.1</commons.csv.version>
    <jackson.version>2.22.1</jackson.version>
    <kafka.version>4.3.1</kafka.version>
    <micrometer.version>1.17.0</micrometer.version>
    <!-- Must match the apache/spark image tag in docker-compose.yml. -->
    <spark.version>4.1.3</spark.version>
    <spring.boot.version>3.5.3</spring.boot.version>
    <jmh.version>1.37</jmh.version>
    <slf4j.version>2.0.16</slf4j.version>
    <awaitility.version>4.3.0</awaitility.version>
    <!--
      logback-classic and logback-core are two jars that must move together; they share
      package-private API. Pinning only classic left core to be resolved by Spring Boot's BOM,
      which produced classic 1.5.12 against core 1.5.18 and an AbstractMethodError the instant
      anything tried to log. Both are managed below against this one property.
    -->
    <logback.version>1.5.18</logback.version>
    <junit.version>5.11.3</junit.version>
    <assertj.version>3.26.3</assertj.version>
  </properties>

  <!--
    dependencyManagement does NOT add dependencies to anything. It only says
    "IF a module asks for this artifact, use this version." Child modules then
    declare <dependency> without a <version>. One place to bump versions.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.headway</groupId>
        <artifactId>headway-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.headway</groupId>
        <artifactId>headway-gtfs</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-csv</artifactId>
        <version>${commons.csv.version}</version>
      </dependency>

      <dependency>
        <groupId>org.mobilitydata</groupId>
        <artifactId>gtfs-realtime-bindings</artifactId>
        <version>${gtfs.rt.bindings.version}</version>
      </dependency>

      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>${guava.version}</version>
      </dependency>

      <!--
        A BOM ("bill of materials"). Importing it pins every Jackson artifact to one consistent
        version at once. Jackson is split across many jars that must match exactly; mixing a 2.22
        databind with a 2.15 core is a classic source of NoSuchMethodError at runtime.
      -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>org.apache.kafka</groupId>
        <artifactId>kafka-clients</artifactId>
        <version>${kafka.version}</version>
      </dependency>

      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-core</artifactId>
        <version>${micrometer.version}</version>
      </dependency>

      <dependency>
        <groupId>org.awaitility</groupId>
        <artifactId>awaitility</artifactId>
        <version>${awaitility.version}</version>
        <scope>test</scope>
      </dependency>

      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-core</artifactId>
        <version>${logback.version}</version>
      </dependency>

      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>

      <!--
        Spring Boot's BOM is deliberately NOT imported here. It lives in headway-api's own pom.

        It was here first, and it broke Spark. Boot's BOM pins several hundred artifacts, most of
        which have nothing to do with Spring - Netty among them. Importing it in the parent applied
        Boot's Netty 4.1 to every module, including headway-stream, where Spark 4.1 needs 4.2 and
        died with NoClassDefFoundError: io/netty/channel/nio/NioIoHandler. Nothing in the API module
        was involved; the damage was entirely in a sibling that had never heard of Spring.

        The lesson generalises: a BOM is not a suggestion for the module that wants it, it is a
        constraint on everything that inherits it. Scope one to the module that needs it.
      -->
    </dependencies>
  </dependencyManagement>

  <!-- Every module gets JUnit 5 + AssertJ for tests. -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <!--
              Keep method parameter names in the class file. Without this, javac discards them and
              anything doing reflection sees arg0, arg1. Spring Boot's own starter-parent sets it
              for exactly this reason, and this build deliberately does not inherit from that pom -
              so it has to be set here.

              The symptom when it is missing is not a compile error. It is a 500 at runtime on the
              first request to a handler with an unnamed @PathVariable, which is how it was found:
              "Name for argument of type [java.lang.String] not specified".
            -->
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
          <configuration>
            <!--
              mainClass is a *required* parameter, so it must be set even for the modules
              where exec is skipped, or Maven refuses to start the goal at all.
            -->
            <mainClass>${exec.mainClass}</mainClass>
            <skip>${exec.skip}</skip>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring.boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
