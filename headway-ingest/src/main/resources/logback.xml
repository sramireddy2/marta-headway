<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging config. SLF4J is the API your code calls; Logback is the engine that actually
  writes the lines. Swapping engines later means changing one dependency, not your code.
-->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{20} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>

  <logger name="dev.headway" level="DEBUG"/>
</configuration>
