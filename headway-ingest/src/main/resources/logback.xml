<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging config. SLF4J is the API your code calls; Logback is the engine that actually
  writes the lines. Swapping engines later means changing one dependency, not your code.
-->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{20} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>

  <logger name="dev.headway" level="DEBUG"/>

  <!--
    Kafka's AbstractConfig logs every single resolved config value at INFO on each client
    creation - roughly 90 lines per producer, consumer and admin client. Useful once when
    debugging a connection problem, pure noise otherwise. WARN keeps genuine problems
    (disconnections, retries, coordinator changes) visible while hiding the dump.
  -->
  <logger name="org.apache.kafka" level="WARN"/>
  <logger name="org.apache.kafka.clients.producer.ProducerConfig" level="WARN"/>
  <logger name="org.apache.kafka.common.metrics" level="WARN"/>
</configuration>
